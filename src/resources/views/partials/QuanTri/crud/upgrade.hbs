<div class="admin-product-page admin-product-upgrade">
  <header class="topbar admin-product-heading">
    <div>
      <p class="admin-product-kicker">Kho phim / Chỉnh sửa</p>
      <h1>Sửa sản phẩm</h1>
      <p class="admin-product-identity">/{{product.slug}}</p>
    </div>
    <a class="admin-form-button admin-form-button--secondary" href="/admin/products">
      <i class="fa-solid fa-arrow-left"></i> Danh sách DVD
    </a>
  </header>

  <section class="table-panel">
    <form class="admin-product-form" method="POST" action="/admin/products/{{product._id}}/upgrade">
      {{> QuanTri/crud/product-fields}}
      <div class="admin-form-actions">
        <button class="admin-form-button admin-form-submit" type="submit">
          <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi
        </button>
        <a class="admin-form-button admin-form-button--secondary" href="/admin/products">Hủy</a>
      </div>
    </form>
  </section>
</div>
