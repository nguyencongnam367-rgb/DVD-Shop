<header class="topbar">
    <form class="search" method="GET" action="/admin/users">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="search" name="q" value="{{q}}" placeholder="Tìm kiếm khách hàng..." aria-label="Tìm kiếm khách hàng">
        <button type="submit" aria-label="Tìm kiếm"><i class="fa-solid fa-arrow-right"></i></button>
    </form>

    <div class="top-actions">
        <button class="icon-btn"><i class="fa-solid fa-bell"></i></button>
        <button class="icon-btn"><i class="fa-solid fa-message"></i></button>
        <div class="user-card">
            <div class="avatar">C</div>
            <div>
                <div class="user-name">Cong Ga</div>
                <small>Admin</small>
            </div>
        </div>
    </div>
</header>

<section class="table-panel" style="margin-top: 24px;">
    <div class="panel-head">
        <span>Danh sách khách hàng</span>
        <a class="admin-form-button" href="/admin/users/add"><i class="fa-solid fa-plus"></i> Thêm mới</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>Khách hàng</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            {{#each users}}
            <tr>
                <td>
                    <div class="product">
                        <div class="thumb">{{initial this.fullName this.username}}</div>
                        <div>
                            <strong>{{#if this.fullName}}{{this.fullName}}{{else}}{{this.username}}{{/if}}</strong>
                        </div>
                    </div>
                </td>
                <td>{{this.email}}</td>
                <td>{{this.role}}</td>
                <td>
                    {{#if this.isActive}}
                    <span class="pill green">Hoạt động</span>
                    {{else}}
                    <span class="pill yellow">Bị khoá</span>
                    {{/if}}
                </td>
                <td class="admin-product-actions">
                    <a class="admin-table-action" href="/admin/users/{{this._id}}/edit">Sửa</a>
                    {{#unless (eq this._id ../currentUserId)}}
                    <form method="POST" action="/admin/users/{{this._id}}/delete" onsubmit="return confirm('Bạn có chắc muốn xóa khách hàng này?');">
                        <button class="admin-table-action admin-table-action--delete" type="submit">Xóa</button>
                    </form>
                    {{/unless}}
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="5" style="text-align:center; color: var(--muted);">
                    {{#if q}}Không tìm thấy khách hàng phù hợp.{{else}}Chưa có khách hàng nào.{{/if}}
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>
