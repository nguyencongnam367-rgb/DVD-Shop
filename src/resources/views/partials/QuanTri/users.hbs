<header class="topbar">
    <div class="search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" placeholder="Tìm kiếm khách hàng..."></input>
    </div>

    <div class="top-actions">
        <button class="icon-btn"><i class="fa-solid fa-bell"></i></button>
        <button class="icon-btn"><i class="fa-solid fa-message"></i></button>
        <div class="user-card">
            <div class="avatar">C</div>
            <div>
                <div class="user-name">Cong Ga</div>
                <small>Admin</small>
            </div>
        </div>
    </div>
</header>

<section class="table-panel" style="margin-top: 24px;">
    <div class="panel-head">
        <span>Danh sách khách hàng</span>
        <button class="admin-action-button">+ Thêm mới</button>
    </div>

    <table>
        <thead>
            <tr>
                <th>Khách hàng</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            {{#each users}}
            <tr>
                <td>
                    <div class="product">
                        <div class="thumb">{{initial this.fullName this.username}}</div>
                        <div>
                            <strong>{{#if this.fullName}}{{this.fullName}}{{else}}{{this.username}}{{/if}}</strong>
                        </div>
                    </div>
                </td>
                <td>{{this.email}}</td>
                <td>{{this.role}}</td>
                <td>
                    {{#if this.isActive}}
                    <span class="pill green">Hoạt động</span>
                    {{else}}
                    <span class="pill yellow">Bị khoá</span>
                    {{/if}}
                </td>
                <td><a href="/admin/users/{{this._id}}/edit" style="color: var(--primary); font-weight: 700;">Sửa</a></td>
            </tr>
            {{else}}
            <tr>
                <td colspan="5" style="text-align:center; color: var(--muted);">Chưa có khách hàng nào.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>
