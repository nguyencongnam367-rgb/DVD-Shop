<header class="topbar">
    <div class="search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" placeholder="Tìm kiếm đơn hàng..."></input>
    </div>

    <div class="top-actions">
        <button class="icon-btn"><i class="fa-solid fa-bell"></i></button>
        <button class="icon-btn"><i class="fa-solid fa-message"></i></button>
        <div class="user-card">
            <div class="avatar">C</div>
            <div>
                <div class="user-name">I'm Admin</div>
                <small>Admin</small>
            </div>
        </div>
    </div>
</header>

<section class="table-panel order-table-panel" style="margin-top: 24px;">
    <div class="panel-head">
        <span>Danh sách đơn hàng DVD</span>
     </div>

    {{#if orderNotice}}<p class="order-admin-notice" role="status">{{orderNotice}}</p>{{/if}}

    <table>
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Tổng tiền</th>
                <th>Ngày đặt</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            {{#each orders}}
            <tr>
                <td>#{{this.orderCode}}</td>
                <td>{{#if this.userId.fullName}}{{this.userId.fullName}}{{else}}{{this.receiverName}}{{/if}}</td>
                <td>{{formatVND this.totalAmount}}</td>
                <td>{{formatDate this.createdAt}}</td>
                <td>
                    {{#if (eq this.status "Hoàn thành")}}
                    <span class="pill green">Đã giao</span>
                    {{else if (eq this.status "Đang giao")}}
                    <span class="pill yellow">Đang xử lý</span>
                    {{else if (eq this.status "Đã huỷ")}}
                    <span class="pill yellow">Đã huỷ</span>
                    {{else}}
                    <span class="pill yellow">Chờ xác nhận</span>
                    {{/if}}
                </td>
                <td>
                    {{#if (eq this.status "Chờ xử lý")}}
                    <div class="order-admin-actions">
                        <form action="/admin/orders/{{this._id}}/approve" method="POST">
                            <button class="order-admin-action order-admin-action--approve" type="submit">Đồng ý</button>
                        </form>
                        <form action="/admin/orders/{{this._id}}/reject" method="POST" onsubmit="return confirm('Bạn có chắc muốn từ chối đơn hàng này?');">
                            <button class="order-admin-action order-admin-action--reject" type="submit">Từ chối</button>
                        </form>
                    </div>
                    {{else}}
                    <span class="order-admin-processed">Đã xử lý</span>
                    {{/if}}
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="6" style="text-align:center; color: var(--muted);">Chưa có đơn hàng nào.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>
