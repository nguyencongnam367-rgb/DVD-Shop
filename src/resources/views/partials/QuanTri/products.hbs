<header class="topbar">
    <div class="search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" placeholder="Tìm kiếm DVD..."></input>
    </div>

    <div class="top-actions">
        <button class="icon-btn"><i class="fa-solid fa-bell"></i></button>
        <button class="icon-btn"><i class="fa-solid fa-message"></i></button>
        <div class="user-card">
            <div class="avatar">C</div>
            <div>
                <div class="user-name">Cong Ga</div>
                <small>Admin</small>
            </div>
        </div>
    </div>
</header>

<section class="table-panel" style="margin-top: 24px;">
    <div class="panel-head">
        <span>Danh sách DVD</span>
        <a class="admin-form-button" href="/admin/products/add"><i class="fa-solid fa-plus"></i> Thêm mới</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>DVD</th>
                <th>Thể loại</th>
                <th>Giá</th>
                <th>Kho</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            {{#each products}}
            <tr>
                <td>
                    <div class="product">
                        <div class="thumb">{{initial this.name}}</div>
                        <div>
                            <strong>{{this.name}}</strong>
                        </div>
                    </div>
                </td>
                <td>{{#if this.categoryId.name}}{{this.categoryId.name}}{{else}}Chưa phân loại{{/if}}</td>
                <td>{{formatVND this.price}}</td>
                <td>{{this.stock}}</td>
                <td>
                    {{#if this.stock}}
                        {{#if (gt this.stock 20)}}
                        <span class="pill green">Còn hàng</span>
                        {{else}}
                        <span class="pill yellow">Sắp hết</span>
                        {{/if}}
                    {{else}}
                    <span class="pill yellow">Hết hàng</span>
                    {{/if}}
                </td>
                <td><a class="admin-table-action" href="/admin/products/{{this._id}}/upgrade">Sửa</a></td>
            </tr>
            {{else}}
            <tr>
                <td colspan="6" style="text-align:center; color: var(--muted);">Chưa có DVD nào.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>
