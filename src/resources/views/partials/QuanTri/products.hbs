<header class="topbar">
    <div class="search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" placeholder="Tìm kiếm DVD..."></input>
    </div>

    <div class="top-actions">
        <button class="icon-btn"><i class="fa-solid fa-bell"></i></button>
        <button class="icon-btn"><i class="fa-solid fa-message"></i></button>
        <div class="user-card">
            <div class="avatar">C</div>
            <div>
                <div class="user-name">Cong Ga</div>
                <small>Admin</small>
            </div>
        </div>
    </div>
</header>

<section class="table-panel" style="margin-top: 24px;">
    <div class="panel-head">
        <span>Danh sách DVD</span>
        <button style="border:none; background: var(--primary); color:white; border-radius: 10px; padding: 10px 14px; font-weight: 700; cursor: pointer;">+ Thêm mới</button>
    </div>

    <table>
        <thead>
            <tr>
                <th>DVD</th>
                <th>Thể loại</th>
                <th>Giá</th>
                <th>Kho</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <div class="product">
                        <div class="thumb">D</div>
                        <div>
                            <strong>Dune: Part Two</strong>
                        </div>
                    </div>
                </td>
                <td>Hành động</td>
                <td>₫220.000</td>
                <td>245</td>
                <td><span class="pill green">Còn hàng</span></td>
            </tr>
            <tr>
                <td>
                    <div class="product">
                        <div class="thumb" style="background: linear-gradient(135deg, #dfeaff, #cfe0ff); color: #2f6cff;">S</div>
                        <div>
                            <strong>Spider-Man: Across the Spider-Verse</strong>
                        </div>
                    </div>
                </td>
                <td>Hoạt hình</td>
                <td>₫240.000</td>
                <td>112</td>
                <td><span class="pill green">Còn hàng</span></td>
            </tr>
            <tr>
                <td>
                    <div class="product">
                        <div class="thumb" style="background: linear-gradient(135deg, #eafaf0, #d8f8df); color: var(--green);">Y</div>
                        <div>
                            <strong>Your Name - Limited Edition</strong>
                        </div>
                    </div>
                </td>
                <td>Anime</td>
                <td>₫180.000</td>
                <td>19</td>
                <td><span class="pill yellow">Sắp hết</span></td>
            </tr>
        </tbody>
    </table>
</section>

