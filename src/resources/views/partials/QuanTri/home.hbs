<header class="topbar">
  <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input type="text" placeholder="Tìm kiếm DVD..." /></div>
  <div class="top-actions">
    <div class="user-card"><div class="avatar">{{initial currentUser.username}}</div>
      <div><div class="user-name">{{currentUser.username}}</div><small>Admin</small></div></div>
  </div>
</header>

<section class="banner">
  <div>
    <span class="badge">DVD style</span>
    <h1>Dashboard cửa hàng DVD</h1>
    <p>Quản lý kho phim, khách hàng và đơn hàng.</p>
  </div>
</section>

<section class="stats-grid">
  <div class="stat-card"><div class="stat-top"><h3>Đơn hàng</h3><div class="icon-box blue"><i class="fa-solid fa-box-open"></i></div></div><div class="value">{{totalOrders}}</div></div>
  <div class="stat-card"><div class="stat-top"><h3>Khách hàng</h3><div class="icon-box green"><i class="fa-solid fa-user-group"></i></div></div><div class="value">{{totalUsers}}</div></div>
  <div class="stat-card"><div class="stat-top"><h3>Doanh thu (không gồm đơn hủy)</h3><div class="icon-box orange"><i class="fa-solid fa-sack-dollar"></i></div></div><div class="value">{{formatVND totalRevenue}}</div></div>
  <div class="stat-card"><div class="stat-top"><h3>Tổng số lượng sản phẩm trong kho</h3><div class="icon-box green"><i class="fa-solid fa-boxes-stacked"></i></div></div><div class="value">{{totalProductQuantity}}</div></div>
</section>

<a class="dashboard-report-link" href="/admin/reports">
  <span class="dashboard-report-link__icon"><i class="fa-solid fa-chart-column"></i></span>
  <span><strong>Mở trang báo cáo</strong><small>Xem thống kê doanh thu, tồn kho và doanh thu theo tháng</small></span>
  <i class="fa-solid fa-arrow-right dashboard-report-link__arrow"></i>
</a>

<section class="table-panel">
  <div class="panel-head"><span>DVD bán chạy</span><a href="/admin/products" style="color: var(--primary); font-size: 0.82rem;">Quản lý</a></div>
  <table>
    <thead><tr><th>DVD</th><th>Giá</th><th>Đã bán</th><th>Kho</th></tr></thead>
    <tbody>
      {{#each topProducts}}
      <tr>
        <td>
          <div class="product">
            {{#if this.image}}
            <img class="thumb thumb-image" src="{{this.image}}" alt="Ảnh {{this.name}}" loading="lazy">
            {{else}}
            <div class="thumb">{{initial this.name}}</div>
            {{/if}}
            <strong>{{this.name}}</strong>
          </div>
        </td>
        <td>{{formatVND this.price}}</td><td>{{this.soldCount}}</td><td>{{this.stock}}</td>
      </tr>
      {{else}}
      <tr><td colspan="4" style="text-align:center;color:var(--muted);">Chưa có dữ liệu.</td></tr>
      {{/each}}
    </tbody>
  </table>
</section>
