<header class="topbar">
    <div class="search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" placeholder="Tìm kiếm DVD..."></input>
    </div>

    <div class="top-actions">
        <button class="icon-btn"><i class="fa-solid fa-bell"></i></button>
        <button class="icon-btn"><i class="fa-solid fa-message"></i></button>
        <div class="user-card">
            <div class="avatar">C</div>
            <div>
                <div class="user-name">Cong Ga</div>
                <small>Admin</small>
            </div>
        </div>
    </div>
</header>

<section class="banner">
    <div>
        <span class="badge">DVD style</span>
        <h1>Dashboard cửa hàng DVD</h1>
        <p>Quản lý kho phim, khách hàng, doanh thu và hoạt động bán hàng hiệu quả hơn.</p>
    </div>
    <button>Xuất báo cáo</button>
</section>

<section class="stats-grid">
    <div class="stat-card">
        <div class="stat-top">
            <h3>Doanh thu</h3>
            <div class="icon-box orange"><i class="fa-solid fa-wallet"></i></div>
        </div>
        <div class="value">₫12.4M</div>
        <div class="trend">▲ 8.2% so với tháng trước</div>
    </div>

    <div class="stat-card">
        <div class="stat-top">
            <h3>Đơn hàng</h3>
            <div class="icon-box blue"><i class="fa-solid fa-box-open"></i></div>
        </div>
        <div class="value">1,284</div>
        <div class="trend">▲ 12.4% so với tháng trước</div>
    </div>

    <div class="stat-card">
        <div class="stat-top">
            <h3>Khách hàng</h3>
            <div class="icon-box green"><i class="fa-solid fa-user-group"></i></div>
        </div>
        <div class="value">8,420</div>
        <div class="trend">▲ 5.1% so với tháng trước</div>
    </div>

    <div class="stat-card">
        <div class="stat-top">
            <h3>Đánh giá</h3>
            <div class="icon-box yellow"><i class="fa-solid fa-star"></i></div>
        </div>
        <div class="value">4.8/5</div>
        <div class="trend">▲ 1.3% so với tháng trước</div>
    </div>
</section>

<section class="table-panel">
    <div class="panel-head">
        <span>DVD nổi bật</span>
        <a href="#" style="color: var(--primary); font-size: 0.82rem;">Quản lý</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>DVD</th>
                <th>Thể loại</th>
                <th>Giá</th>
                <th>Đã bán</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <div class="product">
                        <div class="thumb">D</div>
                        <div>
                            <strong>Dune: Part Two</strong>
                        </div>
                    </div>
                </td>
                <td>Hành động</td>
                <td>₫220.000</td>
                <td>1,240</td>
                <td><span class="pill green">Bán chạy</span></td>
            </tr>
            <tr>
                <td>
                    <div class="product">
                        <div class="thumb" style="background: linear-gradient(135deg, #dfeaff, #cfe0ff); color: #2f6cff;">S</div>
                        <div>
                            <strong>Spider-Man: Across the Spider-Verse</strong>
                        </div>
                    </div>
                </td>
                <td>Hoạt hình</td>
                <td>₫240.000</td>
                <td>860</td>
                <td><span class="pill green">Bán chạy</span></td>
            </tr>
            <tr>
                <td>
                    <div class="product">
                        <div class="thumb" style="background: linear-gradient(135deg, #eafaf0, #d8f8df); color: var(--green);">Y</div>
                        <div>
                            <strong>Your Name - Limited Edition</strong>
                        </div>
                    </div>
                </td>
                <td>Anime</td>
                <td>₫180.000</td>
                <td>540</td>
                <td><span class="pill yellow">Mới</span></td>
            </tr>
        </tbody>
    </table>
</section>
