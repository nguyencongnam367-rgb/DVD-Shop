<style>
    .cart-shell {
        background: linear-gradient(180deg, #fffaf7 0%, #f7f7f7 100%);
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 18px 45px rgba(31, 31, 31, 0.06);
    }

    .cart-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .cart-title {
        margin: 0;
        font-size: 2rem;
        font-weight: 800;
    }

    .cart-layout {
        display: grid;
        grid-template-columns: 1.6fr 0.8fr;
        gap: 24px;
    }

    .cart-items,
    .cart-summary {
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 22px;
        padding: 20px;
    }

    .cart-item {
        display: grid;
        grid-template-columns: 120px 1fr auto;
        gap: 18px;
        padding: 16px 0;
        border-bottom: 1px solid #f3f3f3;
        align-items: center;
    }

    .cart-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .cart-thumb {
        width: 120px;
        height: 120px;
        border-radius: 18px;
        background: linear-gradient(135deg, #f9d9c9, #ffe7d4);
    }

    .cart-item h4 {
        margin: 0 0 8px;
        font-size: 1rem;
    }

    .cart-small {
        color: #777;
        font-size: 0.85rem;
        margin-bottom: 10px;
    }

    .price-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 10px;
    }

    .price-tag {
        color: #ee4d2d;
        font-weight: 800;
        font-size: 1.05rem;
    }

    .qty-control {
        display: inline-flex;
        align-items: center;
        border: 1px solid #ededed;
        border-radius: 10px;
        overflow: hidden;
    }

    .qty-control button {
        width: 32px;
        height: 32px;
        border: none;
        background: #fff;
        font-size: 1.1rem;
        cursor: pointer;
    }

    .qty-control span {
        width: 36px;
        text-align: center;
        font-weight: 700;
    }

    .summary-box h3 {
        margin: 0 0 18px;
        font-size: 1.3rem;
    }

    .summary-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
        color: #555;
    }

    .summary-row.total {
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #f0f0f0;
        color: #111;
        font-size: 1.1rem;
        font-weight: 800;
    }

    .primary-btn,
    .ghost-btn {
        width: 100%;
        border: none;
        border-radius: 12px;
        padding: 14px 16px;
        font-weight: 800;
        cursor: pointer;
        margin-top: 20px;
    }

    .primary-btn {
        background: linear-gradient(135deg, #ff8f6b, #ee4d2d);
        color: #fff;
    }

    .ghost-btn {
        background: #fff4ef;
        color: #ee4d2d;
        border: 1px solid #ffd4c9;
    }

    @media (max-width: 900px) {
        .cart-layout {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .cart-shell {
            padding: 16px;
        }

        .cart-item {
            grid-template-columns: 1fr;
        }

        .cart-thumb {
            width: 100%;
            height: 180px;
        }
    }
</style>

<div class="cart-shell">
    <div class="cart-header">
        <h1 class="cart-title">Giỏ hàng của bạn</h1>
        <button class="ghost-btn" style="width:auto; margin:0; padding:10px 14px;">Tiếp tục mua sắm</button>
    </div>

    <div class="cart-layout">
        <div class="cart-items">
            <div class="cart-item">
                <div class="cart-thumb" style="background: linear-gradient(135deg, #dbeafe, #bfdbfe);"></div>
                <div>
                    <h4>Dune: Part Two</h4>
                    <div class="cart-small">Phân loại: DVD • Bản đầy đủ</div>
                    <div class="price-row">
                        <span class="price-tag">₫220.000</span>
                        <div class="qty-control">
                            <button>-</button>
                            <span>1</span>
                            <button>+</button>
                        </div>
                    </div>
                </div>
                <div class="price-tag">₫220.000</div>
            </div>

            <div class="cart-item">
                <div class="cart-thumb" style="background: linear-gradient(135deg, #fef1d8, #ffd39d);"></div>
                <div>
                    <h4>Spider-Man: Across the Spider-Verse</h4>
                    <div class="cart-small">Phân loại: DVD • Phim hoạt hình</div>
                    <div class="price-row">
                        <span class="price-tag">₫240.000</span>
                        <div class="qty-control">
                            <button>-</button>
                            <span>1</span>
                            <button>+</button>
                        </div>
                    </div>
                </div>
                <div class="price-tag">₫240.000</div>
            </div>
        </div>

        <aside class="cart-summary">
            <h3>Thông tin đơn hàng</h3>
            <div class="summary-row">
                <span>Tạm tính</span>
                <strong>₫460.000</strong>
            </div>
            <div class="summary-row">
                <span>Phí vận chuyển</span>
                <strong>₫30.000</strong>
            </div>
            <div class="summary-row">
                <span>Giảm giá</span>
                <strong>-₫50.000</strong>
            </div>
            <div class="summary-row total">
                <span>Tổng cộng</span>
                <span>₫440.000</span>
            </div>
            <button class="primary-btn">Tiến hành thanh toán</button>
            <button class="ghost-btn">Mã giảm giá</button>
        </aside>
    </div>
</div>
