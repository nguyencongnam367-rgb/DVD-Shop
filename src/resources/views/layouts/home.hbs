<section class="hero" aria-label="Phim được xem nhiều">
  {{#each popularProducts}}
    <article class="hero-slide{{#if @first}} is-active{{/if}}" aria-hidden="{{#if @first}}false{{else}}true{{/if}}">
      <img class="hero-slide__image" src="{{this.image}}" alt="" />
      <div class="hero-content">
        <p class="hero-subtitle">PHIM ĐƯỢC QUAN TÂM</p>
        <h1 class="hero-title">{{this.name}}</h1>
        <p class="hero-subtitle">{{this.director}}</p>
        <a href="/product/{{this._id}}" class="btn-orange">XEM CHI TIẾT</a>
      </div>
    </article>
  {{else}}
    <div class="hero-content">
      <h1 class="hero-title">THE CINEMATIC COLLECTION.</h1>
      <p class="hero-subtitle">Curated. Cult. Classic.</p>
      <a href="/products" class="btn-orange">KHÁM PHÁ NGAY</a>
    </div>
  {{/each}}
  {{#if popularProducts.length}}
    <button type="button" class="hero-control hero-control--previous" aria-label="Phim trước">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    <button type="button" class="hero-control hero-control--next" aria-label="Phim tiếp theo">
      <i class="fa-solid fa-chevron-right"></i>
    </button>
  {{/if}}
</section>

<main class="section-container">
  <h2 class="section-title">FEATURED DVDS</h2>

  <div class="movie-grid">
    {{#each products}}
      <div class="movie-card">
        <a href="/product/{{this._id}}">
          <div class="poster-box">
            <img src="{{this.image}}" alt="{{this.name}}" />
          </div>
          <div class="movie-name">{{this.name}}</div>
          <div class="movie-desc">{{this.director}}</div>
          <div class="movie-price">{{formatVND this.price}}</div>
        </a>

        <form action="/cart/add" method="POST">
          <input type="hidden" name="productId" value="{{this._id}}" />
          <button type="submit" class="btn-add-cart">
            <span class="morph-icon">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 6h15l-1.5 9h-12z" />
                <circle cx="9" cy="20" r="1.4" />
                <circle cx="18" cy="20" r="1.4" />
                <path d="M3 3h2l1 3" />
              </svg>
            </span>
            Thêm Vào Giỏ Hàng
          </button>
        </form>
      </div>
    {{else}}
      <p style="color: var(--text-soft);">Chưa có sản phẩm nào.</p>
    {{/each}}
  </div>
</main>
{{#if popularProducts.length}}
<script src="/js/home-slider.js" defer></script>
{{/if}}