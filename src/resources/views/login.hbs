<main class="auth-page">
  <section class="auth-card">
    <div class="auth-header">
      <p class="auth-kicker">DVDShop</p>
      <h1>Đăng nhập</h1>
      <p class="auth-subtitle">Khám phá bộ sưu tập DVD mới, đặt hàng nhanh và
        nhận ưu đãi thành viên mỗi tuần.</p>
    </div>

    <form action="/auth/login" method="POST" class="auth-form">
      <div class="auth-field">
        <label for="username">Tên đăng nhập</label>
        <input
          type="text"
          id="username"
          name="username"
          placeholder="Nhập tên đăng nhập"
          required
        />
      </div>

      <div class="auth-field">
        <label for="password">Mật khẩu</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Nhập mật khẩu"
          required
        />
      </div>

      <button type="submit" class="auth-submit">Đăng nhập</button>
    </form>

    <p class="auth-switch">
      Chưa có tài khoản?
      <a href="/auth/register">Đăng ký ngay</a>
    </p>

    <a href="/" class="auth-back">Về trang chủ</a>
  </section>
</main>